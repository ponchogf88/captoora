<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CAPTOORA STUDIO · Flagship 3D Storytelling · Nikon Z9</title>
  <meta name="description" content="Experiencia de producto 3D cinematográfica para Captoora Studio. Nikon Z9 con Nikkor Z 50mm f/1.2 S. Galería de autor en vórtice 3D infinito y estudio en Colinas de San Jerónimo, Monterrey.">
  <link rel="canonical" href="https://captoora.studio/">
  <meta property="og:url" content="https://captoora.studio/">
  <meta property="og:site_name" content="Captoora Studio">

  <!-- GOOGLE FONTS: SYNCOPATE, SYNE & SPACE GROTESK (LUXURY EDITORIAL DISPLAY & MONO) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syncopate:wght@400;700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- THREE.JS, GSAP, SCROLLTRIGGER & LENIS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>

  <style>
    /* ==========================================================================
       RESET & MASTER PALETTE (PURE #000 VOID, CYAN #00d4ff, AMBER #f59e0b)
       ========================================================================== */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    :root {
      --bg: #000000;
      --card-bg: rgba(14, 15, 20, 0.88);
      --border: rgba(255, 255, 255, 0.14);
      --cyan: #00d4ff;
      --amber: #f59e0b;
      --lime: #CCFF00;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --font-display: 'Syncopate', -apple-system, sans-serif;
      --font-serif: 'Syne', -apple-system, sans-serif;
      --font-body: 'Syne', -apple-system, sans-serif;
      --font-mono: 'Space Grotesk', monospace;
    }

    body {
      background-color: var(--bg);
      color: var(--text-main);
      font-family: var(--font-body);
      overflow-x: hidden;
      min-height: 100vh;
      selection-background-color: var(--lime);
      selection-color: #000;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* ==========================================================================
       PERSISTENT HEADER & BRANDING
       ========================================================================== */
    .top-nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 76px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 5000;
      backdrop-filter: blur(20px);
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0) 100%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 14px;
      cursor: pointer;
    }

    .brand-logo-img {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      padding: 3px;
      border: 1.5px solid rgba(204, 255, 0, 0.45);
      background: radial-gradient(circle, rgba(204, 255, 0, 0.12) 0%, rgba(0, 0, 0, 0.65) 80%);
      object-fit: contain;
      filter: drop-shadow(0 0 16px rgba(204, 255, 0, 0.5));
      transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .brand-wrap:hover .brand-logo-img {
      transform: scale(1.08) rotate(5deg);
      border-color: var(--lime);
    }

    .brand-wordmark {
      font-family: var(--font-display);
      font-size: 21px;
      font-weight: 700;
      letter-spacing: 5px;
      color: #ffffff;
      text-transform: uppercase;
      display: flex;
      align-items: baseline;
    }

    /* LEY DE MARCA: ÚLTIMA LETRA "A" ILUMINADA EN LIMA FULGOR */
    .brand-wordmark .lit-a {
      color: var(--lime);
      text-shadow: 0 0 14px rgba(204, 255, 0, 0.95), 0 0 28px rgba(204, 255, 0, 0.6);
      font-size: 22px;
      display: inline-block;
      margin-left: 2px;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .nav-pill-btn {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 9px 18px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .sound-btn {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .sound-btn:hover {
      background: rgba(255, 255, 255, 0.16);
      border-color: #fff;
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
    }
    .sound-btn.muted {
      color: var(--text-muted);
      border-color: rgba(255, 255, 255, 0.1);
    }

    .wa-direct-btn {
      background: var(--lime);
      color: #000;
      border: 1px solid var(--lime);
      box-shadow: 0 0 24px rgba(204, 255, 0, 0.45);
    }
    .wa-direct-btn:hover {
      transform: translateY(-2px) scale(1.03);
      box-shadow: 0 0 35px rgba(204, 255, 0, 0.7);
      background: #ffffff;
      border-color: #ffffff;
    }

    /* ==========================================================================
       ACT 3: STROBE FLASH BURST LAYER (150ms PURE WHITE)
       ========================================================================== */
    #flash-screen {
      position: fixed;
      inset: 0;
      background: #ffffff;
      z-index: 99999;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.07s ease-out;
    }

    /* ==========================================================================
       5-ACT SCROLL CONTAINER (#story-stage)
       Pins the 3D scene across 500vh of smooth scroll
       ========================================================================== */
    #story-stage {
      position: relative;
      height: 520vh;
      background: #000000;
    }

    #webgl-container {
      position: sticky;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000000;
    }

    #webgl-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      z-index: 2;
      pointer-events: auto;
      cursor: crosshair;
    }

    /* ==========================================================================
       ULTRA 8K CINEMATIC CAMERA COMPOSITOR (PEXELS REAL PHOTOGRAPHY)
       ========================================================================== */
    #camera-cinematic-stage {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      perspective: 1200px;
      overflow: hidden;
      pointer-events: none;
      z-index: 10;
    }

    .cam-layer {
      position: absolute;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      transform-style: preserve-3d;
      will-change: transform, opacity;
      transition: opacity 0.3s ease-out;
    }

    .cam-photo {
      max-width: 92vw;
      max-height: 86vh;
      object-fit: contain;
      filter: contrast(1.08) brightness(1.0);
      user-select: none;
      -webkit-user-drag: none;
      mask-image: radial-gradient(ellipse at 50% 50%, rgba(0,0,0,1) 62%, rgba(0,0,0,0) 98%);
      -webkit-mask-image: radial-gradient(ellipse at 50% 50%, rgba(0,0,0,1) 62%, rgba(0,0,0,0) 98%);
      transition: filter 0.3s ease;
    }

    .cam-layer-top {
      opacity: 1;
      transform: scale(1.05) rotateX(10deg);
    }

    .cam-layer-front {
      opacity: 0;
      transform: scale(0.92) rotateY(-15deg);
    }

    .cam-layer-macro {
      opacity: 0;
      transform: scale(1.15);
    }

    /* ANAMORPHIC VOLUMETRIC LIGHTING (CYAN LEFT, AMBER RIGHT) */
    .anamorphic-flare-left {
      position: absolute;
      top: 35%;
      left: 12%;
      width: 480px;
      height: 480px;
      background: radial-gradient(circle, rgba(0, 212, 255, 0.28) 0%, rgba(0, 212, 255, 0.08) 45%, rgba(0, 212, 255, 0) 70%);
      filter: blur(48px);
      pointer-events: none;
      mix-blend-mode: screen;
      animation: pulseCyanGlow 4s infinite alternate ease-in-out;
    }
    .anamorphic-flare-right {
      position: absolute;
      top: 38%;
      right: 12%;
      width: 480px;
      height: 480px;
      background: radial-gradient(circle, rgba(245, 158, 11, 0.30) 0%, rgba(245, 158, 11, 0.08) 45%, rgba(245, 158, 11, 0) 70%);
      filter: blur(48px);
      pointer-events: none;
      mix-blend-mode: screen;
      animation: pulseAmberGlow 4.5s infinite alternate ease-in-out;
    }
    @keyframes pulseCyanGlow {
      0% { transform: scale(0.95); opacity: 0.7; }
      100% { transform: scale(1.1); opacity: 1; }
    }
    @keyframes pulseAmberGlow {
      0% { transform: scale(1.08); opacity: 0.8; }
      100% { transform: scale(0.92); opacity: 1; }
    }

    .lens-specular-sheen {
      position: absolute;
      inset: -50%;
      background: linear-gradient(115deg, rgba(255,255,255,0) 38%, rgba(0,212,255,0.12) 48%, rgba(204,255,0,0.18) 50%, rgba(245,158,11,0.14) 52%, rgba(255,255,255,0) 62%);
      pointer-events: none;
      mix-blend-mode: screen;
      opacity: 0.7;
      transform: translateX(-40%) rotate(-12deg);
      transition: transform 0.5s ease-out;
    }

    /* ==========================================================================
       VIEWFINDER CAMERA FRAMING OVERLAY (MARCO CON DECORACIÓN ESTILO CÁMARA)
       ========================================================================== */
    .camera-viewfinder-frame {
      position: absolute;
      inset: 32px;
      pointer-events: none;
      z-index: 40;
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: opacity 0.5s ease;
    }
    @media (max-width: 768px) {
      .camera-viewfinder-frame { inset: 16px; }
    }

    /* 4 VIEW-FINDER CORNERS CON MARCAS DE CALIBRACIÓN */
    .vf-corner {
      position: absolute;
      width: 32px;
      height: 32px;
      border-color: rgba(255, 255, 255, 0.55);
      border-style: solid;
    }
    .vf-tl { top: -2px; left: -2px; border-width: 2px 0 0 2px; }
    .vf-tr { top: -2px; right: -2px; border-width: 2px 2px 0 0; }
    .vf-bl { bottom: -2px; left: -2px; border-width: 0 0 2px 2px; }
    .vf-br { bottom: -2px; right: -2px; border-width: 0 2px 2px 0; }
    .vf-corner::after {
      content: '';
      position: absolute;
      width: 5px;
      height: 5px;
      background: var(--lime);
      box-shadow: 0 0 8px var(--lime);
    }
    .vf-tl::after { top: -1px; left: -1px; }
    .vf-tr::after { top: -1px; right: -1px; }
    .vf-bl::after { bottom: -1px; left: -1px; }
    .vf-br::after { bottom: -1px; right: -1px; }

    /* REGLA DE TERCIOS CINEMATOGRÁFICA */
    .vf-grid-guide {
      position: absolute;
      background: rgba(255, 255, 255, 0.04);
      pointer-events: none;
    }
    .vf-h1 { top: 33.33%; left: 0; right: 0; height: 1px; }
    .vf-h2 { top: 66.66%; left: 0; right: 0; height: 1px; }
    .vf-v1 { left: 33.33%; top: 0; bottom: 0; width: 1px; }
    .vf-v2 { left: 66.66%; top: 0; bottom: 0; width: 1px; }

    /* RETÍCULA DE ENFOQUE AF CENTRAL */
    .vf-center-reticle {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 90px;
      height: 90px;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }
    .reticle-box {
      position: absolute;
      inset: 10px;
      border: 1px solid rgba(0, 212, 255, 0.4);
      border-radius: 4px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reticle-box.locked {
      border-color: var(--lime);
      box-shadow: 0 0 20px rgba(204, 255, 0, 0.7);
      transform: scale(0.94);
    }
    .reticle-crosshair {
      position: absolute;
      width: 16px;
      height: 16px;
    }
    .reticle-crosshair::before, .reticle-crosshair::after {
      content: '';
      position: absolute;
      background: rgba(255, 255, 255, 0.65);
    }
    .reticle-crosshair::before {
      top: 7px; left: 0; right: 0; height: 1px;
    }
    .reticle-crosshair::after {
      left: 7px; top: 0; bottom: 0; width: 1px;
    }
    .reticle-lock-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 10px var(--cyan);
      transition: background 0.3s ease, box-shadow 0.3s ease;
    }
    .reticle-box.locked ~ .reticle-lock-dot {
      background: var(--lime);
      box-shadow: 0 0 12px var(--lime);
    }

    /* TELEMETRÍA DE CÁMARA (INDICADOR REC & VÚMETROS) */
    .rec-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #ef4444;
      font-weight: 700;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 2px;
    }
    .rec-dot {
      width: 8px;
      height: 8px;
      background: #ef4444;
      border-radius: 50%;
      box-shadow: 0 0 10px #ef4444;
      animation: blinkRec 1.2s infinite ease-in-out;
    }
    @keyframes blinkRec {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.2; }
    }

    .vu-meter-bar {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 1px;
      color: rgba(255, 255, 255, 0.45);
    }
    .vu-level {
      display: inline-block;
      width: 44px;
      height: 4px;
      background: rgba(255,255,255,0.12);
      border-radius: 2px;
      overflow: hidden;
      position: relative;
    }
    .vu-fill {
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 75%;
      background: linear-gradient(90deg, #10b981 0%, #f59e0b 70%, #ef4444 100%);
      animation: pulseVu 0.8s infinite alternate ease-in-out;
    }
    @keyframes pulseVu {
      0% { width: 55%; }
      100% { width: 90%; }
    }

    /* ==========================================================================
       OVERLAY HUD & ACT LABELS
       ========================================================================== */
    .hud-overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
      padding: 96px 40px 40px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 100;
      transition: opacity 0.4s ease;
    }

    .hud-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 2.5px;
      color: rgba(255, 255, 255, 0.45);
      text-transform: uppercase;
    }

    .hud-lens-tag {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .hud-lens-tag .lens-name {
      color: #fff;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 3px;
    }
    .hud-lens-tag .lens-sub {
      color: var(--amber);
      font-size: 10px;
      letter-spacing: 2px;
    }

    .hud-center-brackets {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: min(75vw, 440px);
      height: min(75vw, 440px);
      border: 1px dashed rgba(255, 255, 255, 0.12);
      border-radius: 50%;
      pointer-events: none;
      animation: spinHud 40s linear infinite;
    }
    @keyframes spinHud {
      from { transform: translate(-50%, -50%) rotate(0deg); }
      to { transform: translate(-50%, -50%) rotate(360deg); }
    }

    .hud-center-brackets::before {
      content: '';
      position: absolute;
      inset: 40px;
      border: 1px solid rgba(0, 212, 255, 0.1);
      border-radius: 50%;
    }

    /* ACT 1: REVEAL BADGE */
    #act1-hud {
      text-align: center;
      transition: opacity 0.3s ease;
    }
    .act1-kicker {
      font-family: var(--font-display);
      font-size: 11px;
      letter-spacing: 4px;
      color: var(--cyan);
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .act1-title {
      font-family: var(--font-display);
      font-size: clamp(26px, 3.8vw, 48px);
      font-weight: 700;
      letter-spacing: 6px;
      text-transform: uppercase;
      background: linear-gradient(180deg, #ffffff 0%, rgba(255, 255, 255, 0.45) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .act1-scroll-cue {
      margin-top: 12px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 2.5px;
      color: var(--amber);
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .scroll-bounce {
      animation: bounceCue 1.6s infinite ease-in-out;
    }
    @keyframes bounceCue {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(6px); }
    }

    /* ACT 2: FACE OFF QUOTE */
    #act2-quote {
      position: absolute;
      bottom: 110px;
      left: 0;
      width: 100%;
      text-align: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 120;
    }
    .act2-quote-text {
      font-family: var(--font-serif);
      font-size: clamp(16px, 2.2vw, 26px);
      font-weight: 600;
      font-style: italic;
      letter-spacing: 2px;
      color: #ffffff;
      text-shadow: 0 0 30px rgba(0, 212, 255, 0.6);
      background: rgba(8, 9, 12, 0.85);
      padding: 14px 34px;
      border-radius: 999px;
      display: inline-block;
      border: 1px solid rgba(0, 212, 255, 0.35);
      backdrop-filter: blur(14px);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);
    }

    /* ACT 3: FLASH QUOTE */
    #act3-quote {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 90%;
      max-width: 860px;
      text-align: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
      background: rgba(8, 9, 12, 0.82);
      padding: 32px 44px;
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(18px);
      box-shadow: 0 0 60px rgba(0, 0, 0, 0.9);
      z-index: 120;
    }
    .act3-quote-text {
      font-family: var(--font-serif);
      font-size: clamp(28px, 4.2vw, 54px);
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: 0.5px;
      color: #ffffff;
      text-shadow: 0 0 45px rgba(255, 255, 255, 0.75);
    }
    .act3-quote-sub {
      margin-top: 16px;
      font-family: var(--font-display);
      font-size: 13px;
      letter-spacing: 4px;
      color: var(--amber);
      text-transform: uppercase;
    }

    /* HUD BOTTOM BAR */
    .hud-bottom-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 2px;
      color: rgba(255, 255, 255, 0.5);
    }
    .hud-specs-pills {
      display: flex;
      gap: 16px;
    }
    .hud-pill {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 4px 10px;
      border-radius: 4px;
      color: #fff;
    }

    /* ==========================================================================
       ACT 5: INSIDE THE CAMERA (THE 3D INFINITE GALLERY)
       Directly inspired by Poncho's Reelfolio Screen Recording
       ========================================================================== */
    #inside-camera-stage {
      position: relative;
      background: radial-gradient(circle at 50% 20%, #060910 0%, #000000 70%);
      padding: 100px 32px 140px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      overflow: hidden;
      min-height: 100vh;
    }

    /* PERFORACIONES ANALÓGICAS CONTINUAS */
    .film-ribbon {
      display: flex;
      padding: 14px 0;
      border-top: 2px dashed rgba(255, 255, 255, 0.16);
      border-bottom: 2px dashed rgba(255, 255, 255, 0.16);
      overflow: hidden;
      white-space: nowrap;
      margin-bottom: 80px;
      background: #020204;
    }
    .film-text {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 4px;
      color: rgba(255, 255, 255, 0.4);
      animation: ribbonScroll 30s linear infinite;
    }
    @keyframes ribbonScroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    .gallery-wrap {
      max-width: 1400px;
      margin: 0 auto;
    }

    .gallery-hero-header {
      text-align: center;
      margin-bottom: 60px;
    }
    .gallery-kicker {
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 3px;
      color: var(--amber);
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .gallery-title {
      font-size: clamp(32px, 5vw, 64px);
      font-weight: 900;
      letter-spacing: -1px;
      line-height: 1.1;
      margin-bottom: 18px;
    }
    .gallery-desc {
      max-width: 720px;
      margin: 0 auto;
      color: var(--text-muted);
      font-size: 16px;
      line-height: 1.7;
    }

    /* SWITCHER DE VISTAS (VÓRTICE 3D SWIRL vs MURO DE REVELADO) */
    .view-mode-selector {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-bottom: 50px;
      flex-wrap: wrap;
    }
    .view-mode-btn {
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 10px 22px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.14);
      color: #fff;
      cursor: pointer;
      transition: all 0.25s ease;
    }
    .view-mode-btn:hover {
      background: rgba(255, 255, 255, 0.14);
      border-color: #fff;
    }
    .view-mode-btn.active {
      background: #ffffff;
      color: #000000;
      border-color: #ffffff;
      box-shadow: 0 0 24px rgba(255, 255, 255, 0.35);
    }

    /* ==========================================================================
       VISTA 1: 3D SPIRAL VORTEX (REELFOLIO INSPIRATION)
       ========================================================================== */
    .vortex-container {
      position: relative;
      width: 100%;
      height: 740px;
      perspective: 1400px;
      perspective-origin: 50% 50%;
      overflow: hidden;
      margin-bottom: 100px;
      background: radial-gradient(circle at center, #0a0d16 0%, #000000 75%);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 28px;
      cursor: grab;
      user-select: none;
    }
    .vortex-container:active {
      cursor: grabbing;
    }

    .vortex-stage {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      transform-style: preserve-3d;
      transition: transform 0.05s ease-out;
    }

    /* REELFOLIO FLOATING CARD: BORDER RADIUS 26PX, SOFT WHITE OFFSET SHADOW */
    .vortex-card {
      position: absolute;
      top: -190px;
      left: -140px;
      width: 280px;
      height: 380px;
      transform-style: preserve-3d;
      border-radius: 24px;
      overflow: hidden;
      background: #090b10;
      /* Soft white offset shadow signature Captoora */
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.95), 0 0 45px rgba(255, 255, 255, 0.08), -6px -6px 25px rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.18);
      cursor: pointer;
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .vortex-card:hover {
      border-color: var(--lime);
      box-shadow: 0 30px 70px rgba(0, 0, 0, 1), 0 0 50px rgba(204, 255, 0, 0.35);
    }

    .vortex-card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }

    .vortex-card-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.9) 100%);
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      pointer-events: none;
    }
    .vortex-badge {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 2px;
      color: var(--amber);
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .vortex-card-title {
      font-size: 15px;
      font-weight: 800;
      color: #fff;
    }

    .vortex-hint-pill {
      position: absolute;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(0, 0, 0, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 8px 20px;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 2px;
      color: var(--cyan);
      pointer-events: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* ==========================================================================
       VISTA 2: MURO DE REVELADO 3D (LOOKBOOK GRID CON PARALLAX TILT)
       ========================================================================== */
    .grid-view-container {
      display: none; /* Toggled by JS */
      margin-bottom: 100px;
    }
    .grid-view-container.active {
      display: block;
    }

    /* CATEGORY PILL FILTER */
    .collection-filter {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-bottom: 40px;
      flex-wrap: wrap;
    }
    .cat-pill {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 8px 18px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }
    .cat-pill:hover, .cat-pill.active {
      color: #000;
      background: var(--lime);
      border-color: var(--lime);
      box-shadow: 0 0 20px rgba(204, 255, 0, 0.35);
    }

    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 32px;
    }

    .photo-card {
      background: #090b10;
      border-radius: 22px;
      padding: 16px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      /* Soft white offset shadow */
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 35px rgba(255, 255, 255, 0.06);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
      transform-style: preserve-3d;
      cursor: pointer;
    }
    .photo-card:hover {
      transform: translateY(-8px) scale(1.02);
      border-color: rgba(255, 255, 255, 0.4);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 1), 0 0 45px rgba(255, 255, 255, 0.12);
    }

    .photo-img-box {
      width: 100%;
      height: 420px;
      border-radius: 14px;
      overflow: hidden;
      background: #000;
      position: relative;
    }
    .photo-img-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .photo-card:hover .photo-img-box img {
      transform: scale(1.05);
    }

    .photo-meta {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .photo-tag {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.5px;
      color: var(--amber);
      text-transform: uppercase;
    }
    .photo-telemetry {
      font-family: var(--font-mono);
      font-size: 10px;
      color: rgba(255, 255, 255, 0.4);
    }
    .photo-name {
      font-size: 16px;
      font-weight: 800;
      color: #fff;
      margin-top: 4px;
    }

    /* ==========================================================================
       SECTION: TESTIMONIOS (MINIMALIST FLOATING CARDS)
       ========================================================================== */
    .sec-header {
      margin-bottom: 40px;
      text-align: left;
    }
    .sec-kicker {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      color: var(--cyan);
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .sec-title {
      font-size: clamp(28px, 4vw, 42px);
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 24px;
      margin-bottom: 110px;
    }
    .testimonial-card {
      background: rgba(10, 12, 17, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.7);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      backdrop-filter: blur(12px);
    }
    .test-body {
      font-size: 15px;
      line-height: 1.7;
      color: #cbd5e1;
      font-style: italic;
      margin-bottom: 24px;
    }
    .test-user {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .test-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #141721;
      border: 1px solid var(--amber);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      color: var(--amber);
      font-size: 16px;
    }
    .test-details h4 {
      font-size: 14px;
      font-weight: 800;
      color: #fff;
    }
    .test-details p {
      font-size: 11px;
      color: var(--text-muted);
      font-family: var(--font-mono);
    }

    /* ==========================================================================
       SECTION: PAQUETES DE ESTUDIO (FLOATING BLACK GLASS CARDS)
       ========================================================================== */
    .packages-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
      gap: 28px;
      margin-bottom: 110px;
    }

    .pkg-glass-card {
      background: radial-gradient(circle at top right, rgba(255, 255, 255, 0.05) 0%, rgba(10, 12, 17, 0.95) 100%);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 24px;
      padding: 34px 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
      transition: all 0.3s ease;
    }
    .pkg-glass-card:hover {
      transform: translateY(-8px);
      border-color: rgba(255, 255, 255, 0.35);
      box-shadow: 0 30px 70px rgba(0, 0, 0, 1), 0 0 35px rgba(255, 255, 255, 0.08);
    }
    .pkg-glass-card.featured {
      border-color: var(--lime);
      background: radial-gradient(circle at top right, rgba(204, 255, 0, 0.12) 0%, rgba(10, 12, 17, 0.95) 75%);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9), 0 0 40px rgba(204, 255, 0, 0.2);
    }

    .pkg-pill-badge {
      position: absolute;
      top: -12px;
      right: 24px;
      background: var(--lime);
      color: #000;
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 4px 14px;
      border-radius: 999px;
    }
    .pkg-title {
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 8px;
    }
    .pkg-cost {
      font-family: var(--font-mono);
      font-size: 32px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 20px;
    }
    .pkg-cost span {
      font-size: 13px;
      color: var(--text-muted);
      font-weight: 400;
    }
    .pkg-features {
      list-style: none;
      margin-bottom: 28px;
    }
    .pkg-features li {
      font-size: 13.5px;
      color: var(--text-muted);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .pkg-features li::before {
      content: '✓';
      color: var(--lime);
      font-weight: 800;
    }
    .pkg-action-btn {
      width: 100%;
      padding: 14px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 12px;
      color: #fff;
      font-weight: 800;
      font-size: 13px;
      text-align: center;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-family: var(--font-mono);
      transition: all 0.2s;
    }
    .pkg-glass-card.featured .pkg-action-btn {
      background: var(--lime);
      color: #000;
      border-color: var(--lime);
    }
    .pkg-action-btn:hover {
      background: #fff;
      color: #000;
      border-color: #fff;
    }

    /* ==========================================================================
       SECTION: UBICACIÓN & CONTACTO (SAN JERÓNIMO STUDIO)
       ========================================================================== */
    .studio-location-panel {
      background: radial-gradient(circle at 70% 30%, #111422 0%, #06070a 100%);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 28px;
      padding: 48px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 36px;
      margin-bottom: 100px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.9);
    }
    .loc-content h3 {
      font-size: 26px;
      font-weight: 900;
      margin-bottom: 10px;
    }
    .loc-content p {
      color: var(--text-muted);
      font-size: 15px;
      line-height: 1.7;
      max-width: 550px;
    }
    .loc-actions {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
    .btn-maps-action {
      background: #ffffff;
      color: #000000;
      font-weight: 800;
      font-size: 13px;
      padding: 16px 30px;
      border-radius: 999px;
      font-family: var(--font-mono);
      letter-spacing: 1px;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all 0.25s;
    }
    .btn-maps-action:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 30px rgba(255, 255, 255, 0.4);
    }

    /* ==========================================================================
       FINAL GRAND CTA
       "Agenda tu sesión — Deja tu esencia como un fulgor estelar"
       ========================================================================== */
    .final-cta-section {
      text-align: center;
      padding: 80px 20px 40px;
      position: relative;
    }
    .final-cta-kicker {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 3px;
      color: var(--lime);
      text-transform: uppercase;
      margin-bottom: 14px;
    }
    .final-cta-headline {
      font-size: clamp(32px, 5.5vw, 68px);
      font-weight: 900;
      letter-spacing: -1.5px;
      line-height: 1.15;
      max-width: 950px;
      margin: 0 auto 24px;
      background: linear-gradient(180deg, #ffffff 0%, rgba(255, 255, 255, 0.6) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .final-cta-quote {
      font-family: var(--font-mono);
      font-size: 18px;
      color: var(--amber);
      margin-bottom: 44px;
      letter-spacing: 1px;
    }
    .btn-book-master {
      background: var(--lime);
      color: #000000;
      font-weight: 900;
      font-size: 15px;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 20px 44px;
      border-radius: 999px;
      font-family: var(--font-mono);
      display: inline-flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 0 45px rgba(204, 255, 0, 0.5);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-book-master:hover {
      transform: translateY(-4px) scale(1.04);
      background: #ffffff;
      box-shadow: 0 0 65px rgba(255, 255, 255, 0.7);
    }

    footer {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding: 40px 32px;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 11px;
      color: rgba(255, 255, 255, 0.4);
      letter-spacing: 2px;
    }

    /* ==========================================================================
       MODAL LIGHTBOX FULL-FRAME INSPECTION
       ========================================================================== */
    #lightbox-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(25px);
      z-index: 10000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 40px;
    }
    #lightbox-modal.active {
      display: flex;
    }
    .lightbox-content {
      position: relative;
      max-width: 90vw;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .lightbox-img {
      max-width: 100%;
      max-height: 75vh;
      object-fit: contain;
      border-radius: 12px;
      box-shadow: 0 0 50px rgba(0, 0, 0, 1), 0 0 35px rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .lightbox-telemetry {
      margin-top: 16px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 2px;
      color: var(--amber);
      text-align: center;
    }
    .lightbox-close-btn {
      position: absolute;
      top: -45px;
      right: 0;
      background: none;
      border: none;
      color: #fff;
      font-size: 32px;
      cursor: pointer;
      font-family: sans-serif;
    }

    /* ==========================================================================
       SCROLLTIDE REEL SLIDER (3D COVERFLOW CAROUSEL)
       ========================================================================== */
    .reel-carousel-container {
      position: relative;
      width: 100%;
      height: 640px;
      margin-bottom: 80px;
      perspective: 1200px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      user-select: none;
    }
    .reel-carousel-container.hidden {
      display: none;
    }

    .reel-track {
      position: relative;
      width: 100%;
      height: 530px;
      transform-style: preserve-3d;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: grab;
    }
    .reel-track:active {
      cursor: grabbing;
    }

    .reel-card {
      position: absolute;
      width: 310px;
      height: 510px;
      border-radius: 20px;
      overflow: hidden;
      background: #0d1520;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
      transform-style: preserve-3d;
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.55s ease, filter 0.55s ease, border-color 0.4s ease;
      will-change: transform, opacity;
      cursor: pointer;
    }
    .reel-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s ease;
    }
    .reel-card:hover img {
      transform: scale(1.04);
    }
    .reel-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.1) 40%, rgba(0,0,0,0.92) 100%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 24px;
      z-index: 2;
    }
    .reel-tag {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--lime);
      margin-bottom: 6px;
    }
    .reel-name {
      font-family: var(--font-title);
      font-size: 1.2rem;
      font-weight: 700;
      color: #fff;
      line-height: 1.2;
      margin-bottom: 6px;
    }
    .reel-meta {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--text-muted);
    }
    .reel-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
      z-index: 10;
    }
    .reel-arrow-btn {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      cursor: pointer;
      backdrop-filter: blur(12px);
      transition: all 0.25s ease;
    }
    .reel-arrow-btn:hover {
      background: var(--lime);
      color: #000;
      border-color: var(--lime);
      transform: scale(1.08);
      box-shadow: 0 0 20px rgba(204, 255, 0, 0.4);
    }
    .reel-dots {
      display: flex;
      align-items: center;
      gap: 9px;
    }
    .reel-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .reel-dot.active {
      width: 26px;
      border-radius: 999px;
      background: var(--lime);
      box-shadow: 0 0 10px rgba(204, 255, 0, 0.6);
    }

    /* ==========================================================================
       SCROLLTIDE PARALLAX ROW DRIFT
       ========================================================================== */
    .parallax-strip-wrap {
      width: 100%;
      margin: 80px 0 100px 0;
      overflow: hidden;
    }
    .parallax-strip-header {
      text-align: center;
      margin-bottom: 30px;
    }
    .parallax-track-container {
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding: 30px 0;
      cursor: grab;
    }
    .parallax-track-container::-webkit-scrollbar {
      display: none;
    }
    .parallax-track-container:active {
      cursor: grabbing;
    }
    .parallax-row {
      display: flex;
      gap: 36px;
      padding: 0 40px;
      width: max-content;
      align-items: center;
    }
    .parallax-frame {
      position: relative;
      flex-shrink: 0;
      border-radius: 18px;
      overflow: hidden;
      background: #0a0f16;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
      transition: transform 0.4s ease, border-color 0.3s ease;
    }
    .parallax-frame:hover {
      border-color: var(--cyan);
    }
    .parallax-frame.offset-high { transform: translateY(-30px); }
    .parallax-frame.offset-low { transform: translateY(30px); }
    .parallax-frame.offset-mid { transform: translateY(0); }
    .parallax-frame:hover.offset-high { transform: translateY(-38px) scale(1.02); }
    .parallax-frame:hover.offset-low { transform: translateY(22px) scale(1.02); }
    .parallax-frame:hover.offset-mid { transform: translateY(-8px) scale(1.02); }
    .parallax-frame.wide { width: 420px; height: 300px; }
    .parallax-frame.tall { width: 320px; height: 460px; }
    .parallax-frame.square { width: 360px; height: 360px; }
    .parallax-frame .inner-img {
      width: 120%;
      height: 120%;
      margin-left: -10%;
      margin-top: -10%;
      object-fit: cover;
      transition: transform 0.1s linear;
      will-change: transform;
    }
    .parallax-badge {
      position: absolute;
      bottom: 14px;
      left: 14px;
      background: rgba(3, 6, 10, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 5px 12px;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.5px;
      color: #fff;
      backdrop-filter: blur(10px);
      z-index: 3;
    }

    /* ==========================================================================
       RESPONSIVE ADAPTATIONS
       ========================================================================== */
    @media (max-width: 768px) {
      .top-nav { padding: 0 20px; }
      .brand-wordmark { font-size: 16px; }
      .nav-actions { gap: 8px; }
      .nav-pill-btn { padding: 7px 12px; font-size: 10px; }
      .hud-overlay { padding: 86px 20px 20px; }
      .vortex-container { height: 500px; }
      .vortex-card { width: 220px; height: 300px; top: -150px; left: -110px; }
      .studio-location-panel { padding: 30px 20px; }
    }
  </style>
</head>
<body>

  <!-- STROBE FLASH BURST LAYER (ACT 3 - 150ms PURE WHITE FLASH) -->
  <div id="flash-screen"></div>

  <!-- PERSISTENT TOP NAVIGATION BAR -->
  <header class="top-nav">
    <div class="brand-wrap" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
      <img src="assets/captoora_logo_circle_centered.png" alt="Captoora Lens Emblem" class="brand-logo-img">
      <div class="brand-wordmark">
        CAPTOOR<span class="lit-a">A</span>
      </div>
    </div>

    <div class="nav-actions">
      <!-- CAPTOORA BIOMETRICS LAB LINK -->
      <a href="captoora_biometrics.html" class="nav-pill-btn" style="background: rgba(0, 240, 255, 0.12); color: var(--cyan); border: 1px solid rgba(0, 240, 255, 0.45); box-shadow: 0 0 16px rgba(0, 240, 255, 0.25);" title="Ver experiencia interactiva Captoora Biometrics">
        <span>✦ BIOMETRICS</span>
      </a>

      <!-- BOTÓN TOGGLE DE SONIDO (OBTURADOR NIKON Z9 DISPARABLE) -->
      <button class="nav-pill-btn sound-btn" id="sound-toggle-btn" title="Activar/Desactivar sonido del obturador Nikon Z9">
        <span>SONIDO: ON</span> 🔊
      </button>

      <!-- BOTÓN DIRECTO DE RESERVA WHATSAPP -->
      <a href="https://wa.me/528140050088?text=Hola%20Captoora,%20quiero%20agendar%20mi%20sesi%C3%B3n%20en%20el%20estudio" target="_blank" class="nav-pill-btn wa-direct-btn">
        <span>AGENDAR SESIÓN</span> 💬
      </a>
    </div>
  </header>

  <!-- ==========================================================================
       STORY STAGE: 5-ACT SCROLL-DRIVEN 3D EXPERIENCE (520vh)
       ========================================================================== -->
  <main id="story-stage">
    
    <div id="webgl-container">
      <!-- CANVAS FOR AMBIENT PARTICLES & VOLUMETRIC ATMOSPHERE -->
      <canvas id="webgl-canvas"></canvas>

      <!-- ULTRA 8K CINEMATIC CAMERA COMPOSITOR (PEXELS REAL PHOTOGRAPHY) -->
      <div id="camera-cinematic-stage">
        
        <!-- LAYER 1: MACRO TOP VIEW (DIALS & OLED DISPLAY 6932296) -->
        <div class="cam-layer cam-layer-top" id="layer-top-oled">
          <img src="assets/pexels/nikon_hero_6932296.jpg" alt="Nikon Z9 Top View OLED Dial" class="cam-photo">
        </div>

        <!-- LAYER 2: FLAGSHIP 3/4 FRONTAL HERO (6932297) -->
        <div class="cam-layer cam-layer-front" id="layer-front-hero">
          <img src="assets/pexels/nikon_hero_6932297.jpg" alt="Nikon Z9 Flagship Front View" class="cam-photo">
          <div class="anamorphic-flare-left"></div>
          <div class="anamorphic-flare-right"></div>
          <div class="lens-specular-sheen" id="specular-sheen"></div>
        </div>

        <!-- LAYER 3: MACRO SHUTTER RELEASE & PENTAPRISM (6934978) -->
        <div class="cam-layer cam-layer-macro" id="layer-macro-shutter">
          <img src="assets/pexels/nikon_hero_6934978.jpg" alt="Nikon Z9 Shutter Release Macro" class="cam-photo">
        </div>

      </div>

      <!-- VIEWFINDER CAMERA FRAMING OVERLAY (MARCO ESTILO ENCUADRE DE CÁMARA) -->
      <div class="camera-viewfinder-frame" id="camera-vf-frame">
        <!-- 4 CORNERS DE CALIBRACIÓN -->
        <div class="vf-corner vf-tl"></div>
        <div class="vf-corner vf-tr"></div>
        <div class="vf-corner vf-bl"></div>
        <div class="vf-corner vf-br"></div>

        <!-- REGLA DE TERCIOS GUIDES -->
        <div class="vf-grid-guide vf-h1"></div>
        <div class="vf-grid-guide vf-h2"></div>
        <div class="vf-grid-guide vf-v1"></div>
        <div class="vf-grid-guide vf-v2"></div>

        <!-- RETÍCULA AF DE ENFOQUE CENTRAL -->
        <div class="vf-center-reticle" id="af-reticle">
          <div class="reticle-box" id="af-reticle-box"></div>
          <div class="reticle-crosshair"></div>
          <div class="reticle-lock-dot"></div>
        </div>
      </div>

      <!-- LIVE HUD TELEMETRY & OVERLAYS -->
      <div class="hud-overlay">
        
        <!-- HUD TOP BAR -->
        <div class="hud-header-bar">
          <div class="hud-lens-tag">
            <div style="display: flex; align-items: center; gap: 10px;">
              <div class="rec-indicator"><span class="rec-dot"></span>REC</div>
              <span class="lens-name">NIKON Z 9 · NIKKOR 50MM F/1.2 S</span>
            </div>
            <span class="lens-sub">8K 60p N-RAW FX // 45.7 MP STACKED SENSOR</span>
          </div>

          <div style="display: flex; align-items: center; gap: 14px; pointer-events: auto;">
            <!-- VU METERS & BATTERY TELEMETRY -->
            <div class="hud-status-group" style="display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 10px;">
              <div class="vu-meter-bar"><span>CH1</span><span class="vu-level"><span class="vu-fill"></span></span></div>
              <div class="vu-meter-bar"><span>CH2</span><span class="vu-level"><span class="vu-fill" style="animation-delay: -0.3s;"></span></span></div>
              <span style="color: var(--lime); font-weight: 700;">[▮▮▮▯] 84%</span>
            </div>

            <a href="captoora_hub.html" style="text-decoration: none; color: #fff; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.22); padding: 5px 12px; border-radius: 999px; font-weight: 700; font-size: 0.72rem; letter-spacing: 0.05em; display: inline-flex; align-items: center; gap: 6px;">✦ HUB ↗</a>
            <a href="top_10_visual_showcase.html" style="text-decoration: none; color: #000; background: var(--amber); padding: 5px 12px; border-radius: 999px; font-weight: 700; font-size: 0.72rem; letter-spacing: 0.05em; box-shadow: 0 0 16px rgba(245,158,11,0.5); display: inline-flex; align-items: center; gap: 6px;">⚡ LAB MOTIONS ↗</a>
          </div>
        </div>

        <!-- ACT 1: THE REVEAL TITLE -->
        <div id="act1-hud">
          <div class="act1-kicker">Acto 1 // The Reveal // Flagship Inspection</div>
          <h1 class="act1-title">Nikon Z 9 Flagship</h1>
          <div class="act1-scroll-cue">
            <span>Haz Scroll Down para rotar e iniciar la experiencia</span>
            <span class="scroll-bounce">↓</span>
          </div>
        </div>

        <!-- ACT 2: THE FACE OFF (0.30 -> 0.60 SCROLL) -->
        <div id="act2-quote">
          <div class="act2-quote-text">
            "La herramienta no hace al fotógrafo. Pero ayuda."
          </div>
        </div>

        <!-- ACT 3: THE FLASH QUOTE (0.60 -> 0.85 SCROLL) -->
        <div id="act3-quote">
          <div class="act3-quote-text">
            Capturamos lo que el tiempo quiere borrar.
          </div>
          <div class="act3-quote-sub">
            ✦ Disparo de Autor // 1/8000s f/1.2 S ✦
          </div>
        </div>

        <!-- HUD BOTTOM BAR -->
        <div class="hud-bottom-bar">
          <div class="hud-specs-pills">
            <span class="hud-pill">ISO 100</span>
            <span class="hud-pill">1/8000s</span>
            <span class="hud-pill" style="color: var(--lime); font-weight: 700; border-color: rgba(204,255,0,0.4);">f/1.2 S</span>
            <span class="hud-pill">+0.0 EV</span>
            <span class="hud-pill">WB 5600K</span>
            <span class="hud-pill" style="color: var(--cyan);">AF-C [EYE-AF LOCK]</span>
          </div>

          <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px;">
            COLINAS DE SAN JERÓNIMO // MONTERREY, N.L.
          </div>
        </div>

      </div>
    </div>

  </main>

  <!-- ==========================================================================
       ACT 5: INSIDE THE CAMERA (THE 3D INFINITE GALLERY)
       Inspired by Reelfolio.io and Poncho's Screen Recording references
       ========================================================================== -->
  <section id="inside-camera-stage">

    <!-- PERFORACIONES DE ROLLO DE PELÍCULA ANALÓGICA 35MM -->
    <div class="film-ribbon">
      <div class="film-text">
        🎞️ CAPTOORA 400 PRO // FRAME 01 // RETRATO EDITORIAL // FRAME 02 // SIERRA DE CHIPINQUE // LUZ DE AUTOR // MONTERREY 2026 // ZERO CROP // 100% FULL-FRAME // FRAME 03 // BIOMETRÍA CON ALMA // SAN JERÓNIMO STUDIO // FRAME 04 // NAVIDAD 2026 // AMAPOLA EVENTOS 🎞️
      </div>
    </div>

    <div class="gallery-wrap">
      
      <!-- HERO DE LA GALERÍA -->
      <div class="gallery-hero-header">
        <div class="gallery-kicker">Acto 5 // El Interior del Sensor // Luz de Autor</div>
        <h2 class="gallery-title">Captoora Infinite Gallery</h2>
        <p class="gallery-desc">
          Has cruzado el diafragma f/1.2 hacia el interior del sensor. Fotografías reales de estudio y exteriores en 45.7MP. Cero rostros de plástico ni extremidades recortadas: cada toma respeta la anatomía, la luz direccional y el fulgor estelar de cada sujeto.
        </p>
      </div>

      <!-- SELECTOR DE VISTAS (COVERFLOW 3D REELS vs TÚNEL VÓRTICE 3D vs PARALLAX DRIFT vs MURO DE REVELADO) -->
      <div class="view-mode-selector">
        <button class="view-mode-btn active" id="btn-reels-mode" onclick="setGalleryViewMode('reels')">
          🎞️ Coverflow 3D Reel Slider
        </button>
        <button class="view-mode-btn" id="btn-vortex-mode" onclick="setGalleryViewMode('vortex')">
          🌀 Túnel Vórtice 3D (Reelfolio)
        </button>
        <button class="view-mode-btn" id="btn-parallax-mode" onclick="setGalleryViewMode('parallax')">
          ✦ Parallax Drift Strip
        </button>
        <button class="view-mode-btn" id="btn-grid-mode" onclick="setGalleryViewMode('grid')">
          ⊞ Muro de Revelado 45.7MP
        </button>
      </div>

      <!-- ====================================================================
           MODO 0: SCROLLTIDE 3D COVERFLOW REEL SLIDER (ACTIVOS 9:16)
           ==================================================================== -->
      <div class="reel-carousel-container" id="reels-viewport">
        <div class="reel-track" id="index-reel-track">

          <!-- REEL 1: RIM LIGHT ATHLETE -->
          <div class="reel-card" data-index="0" onclick="openLightbox('assets/biometrics_athlete_rimlight.jpg', 'Captoora Biometrics · Esculpido Muscular en Rim Light', 'Nikon Z9 · Nikkor Z 50mm f/1.2 S · 1/250s · f/1.4 · ISO 64')">
            <img src="assets/biometrics_athlete_rimlight.jpg" alt="Atleta Biometrics Rim Light">
            <div class="reel-overlay">
              <span class="reel-tag">BIOMETRICS // RIM LIGHT</span>
              <div class="reel-name">Esculpido Muscular de Autor</div>
              <span class="reel-meta">Nikon Z9 · 50mm f/1.2 S · ISO 64</span>
            </div>
          </div>

          <!-- REEL 2: LULU H. -->
          <div class="reel-card" data-index="1" onclick="openLightbox('assets/media_jpg/FARMASI_CPT_0728_LULU_ESTUDIO_PRO.jpg', 'Lulú H. · Retrato de Autor en Estudio', 'Nikon Z9 · Nikkor Z 50mm f/1.2 S · 1/250s · f/1.4 · ISO 100')">
            <img src="assets/media_jpg/FARMASI_CPT_0728_LULU_ESTUDIO_PRO.jpg" alt="Lulú H. Retrato Editorial">
            <div class="reel-overlay">
              <span class="reel-tag">EDITORIAL // BEAUTY</span>
              <div class="reel-name">Lulú H. · Presencia Ejecutiva</div>
              <span class="reel-meta">1/250s · f/1.4 · 45.7MP Full-Frame</span>
            </div>
          </div>

          <!-- REEL 3: BRENDA M. -->
          <div class="reel-card" data-index="2" onclick="openLightbox('assets/media_jpg/FARMASI_CPT_0554_BRENDA_ESTUDIO_PRO.jpg', 'Brenda M. · Sesión Beauty & Marca', 'Nikon Z9 · 50mm f/1.2 S · ISO 100')">
            <img src="assets/media_jpg/FARMASI_CPT_0554_BRENDA_ESTUDIO_PRO.jpg" alt="Brenda M. Beauty">
            <div class="reel-overlay">
              <span class="reel-tag">BEAUTY // PIEL REAL</span>
              <div class="reel-name">Brenda M. · Definición de Estudio</div>
              <span class="reel-meta">Textura Natural Sin Filtros Plásticos</span>
            </div>
          </div>

          <!-- REEL 4: GLOWTOURS -->
          <div class="reel-card" data-index="3" onclick="openLightbox('assets/media_jpg/pf-glow-cpt_0853.jpg', 'GlowTours Oficial · Set Temático Amapola', 'San Jerónimo Studio · 50mm f/1.2 S')">
            <img src="assets/media_jpg/pf-glow-cpt_0853.jpg" alt="GlowTours Oficial">
            <div class="reel-overlay">
              <span class="reel-tag">EVENTOS // SET AMAPOLA</span>
              <div class="reel-name">GlowTours · Atmósfera Cálida</div>
              <span class="reel-meta">Colinas de San Jerónimo 11</span>
            </div>
          </div>

          <!-- REEL 5: CHIPINQUE -->
          <div class="reel-card" data-index="4" onclick="openLightbox('assets/media_jpg/pf-chipinque-01.jpg', 'Sierra de Chipinque · Senderos Naturales', 'Nikon Z9 · 50mm f/1.2 S · ISO 64')">
            <img src="assets/media_jpg/pf-chipinque-01.jpg" alt="Sierra de Chipinque">
            <div class="reel-overlay">
              <span class="reel-tag">EXTERIORES // SIERRA MADRE</span>
              <div class="reel-name">Senderos de Chipinque 45.7MP</div>
              <span class="reel-meta">Luz Natural de Montaña · Monterrey</span>
            </div>
          </div>

          <!-- REEL 6: EL MEDICO ASESINO -->
          <div class="reel-card" data-index="5" onclick="openLightbox('campaigns/biometrics/POSTER_BIOMETRICS_MEDICO_ASESINO.jpg', 'El Médico Asesino · Anatomía y Fuerza Lucha Libre', 'División Atlética · Monterrey 2026')">
            <img src="campaigns/biometrics/POSTER_BIOMETRICS_MEDICO_ASESINO.jpg" alt="El Médico Asesino Biometrics">
            <div class="reel-overlay">
              <span class="reel-tag">LUCHA LIBRE // LEYENDA</span>
              <div class="reel-name">El Médico Asesino · Anatomía</div>
              <span class="reel-meta">División Atlética · Monterrey 2026</span>
            </div>
          </div>

        </div>

        <!-- REEL NAVIGATION CONTROLS -->
        <div class="reel-controls">
          <button class="reel-arrow-btn" id="btn-idx-reel-prev" aria-label="Anterior">←</button>
          <div class="reel-dots" id="idx-reel-dots"></div>
          <button class="reel-arrow-btn" id="btn-idx-reel-next" aria-label="Siguiente">→</button>
        </div>
      </div>

      <!-- ====================================================================
           MODO 1: TÚNEL VÓRTICE 3D EN ESPIRAL (REELFOLIO SWIRL INSPIRATION)
           ==================================================================== -->
      <div class="vortex-container" id="vortex-viewport" style="display: none;">
        <div class="vortex-stage" id="vortex-spiral-stage">
          <!-- Tarjetas 3D generadas dinámicamente por JavaScript -->
        </div>
        <div class="vortex-hint-pill">
          <span>Arrastra horizontalmente o usa la rueda del ratón para girar el vórtice 3D</span> ✦
        </div>
      </div>

      <!-- ====================================================================
           MODO 2: SCROLLTIDE PARALLAX ROW DRIFT (DESPLAZAMIENTO FLOTANTE)
           ==================================================================== -->
      <div class="parallax-strip-wrap" id="parallax-viewport" style="display: none; margin: 20px 0 60px 0;">
        <div class="parallax-track-container" id="index-parallax-container">
          <div class="parallax-row" id="index-parallax-row">

            <!-- FRAME 1 -->
            <div class="parallax-frame tall offset-high" onclick="openLightbox('assets/biometrics_athlete_rimlight.jpg', 'Captoora Biometrics · Esculpido Muscular en Rim Light', 'Nikon Z9 · Nikkor Z 50mm f/1.2 S · 1/250s · f/1.4 · ISO 64')">
              <img src="assets/biometrics_athlete_rimlight.jpg" alt="Atleta Rim Light" class="inner-img">
              <div class="parallax-badge">01 // BIOMETRICS</div>
            </div>

            <!-- FRAME 2 -->
            <div class="parallax-frame wide offset-low" onclick="openLightbox('campaigns/biometrics/POSTER_BIOMETRICS_MEDICO_ASESINO.jpg', 'El Médico Asesino · Anatomía y Fuerza Lucha Libre', 'División Atlética · Monterrey 2026')">
              <img src="campaigns/biometrics/POSTER_BIOMETRICS_MEDICO_ASESINO.jpg" alt="Médico Asesino" class="inner-img">
              <div class="parallax-badge">02 // FUERZA &amp; MITO</div>
            </div>

            <!-- FRAME 3 -->
            <div class="parallax-frame square offset-mid" onclick="openLightbox('assets/media_jpg/pf-chipinque-01.jpg', 'Sierra de Chipinque · Senderos Naturales', 'Nikon Z9 · 50mm f/1.2 S · ISO 64')">
              <img src="assets/media_jpg/pf-chipinque-01.jpg" alt="Chipinque" class="inner-img">
              <div class="parallax-badge">03 // CHIPINQUE EXTERIORES</div>
            </div>

            <!-- FRAME 4 -->
            <div class="parallax-frame tall offset-low" onclick="openLightbox('assets/media_jpg/FARMASI_CPT_0728_LULU_ESTUDIO_PRO.jpg', 'Lulú H. · Retrato de Autor en Estudio', 'Nikon Z9 · Nikkor Z 50mm f/1.2 S · 1/250s · f/1.4 · ISO 100')">
              <img src="assets/media_jpg/FARMASI_CPT_0728_LULU_ESTUDIO_PRO.jpg" alt="Lulú H." class="inner-img">
              <div class="parallax-badge">04 // LUZ DIRECCIONAL</div>
            </div>

            <!-- FRAME 5 -->
            <div class="parallax-frame wide offset-high" onclick="openLightbox('assets/media_jpg/FARMASI_CPT_0554_BRENDA_ESTUDIO_PRO.jpg', 'Brenda M. · Sesión Beauty &amp; Marca', 'Nikon Z9 · 50mm f/1.2 S · ISO 100')">
              <img src="assets/media_jpg/FARMASI_CPT_0554_BRENDA_ESTUDIO_PRO.jpg" alt="Brenda" class="inner-img">
              <div class="parallax-badge">05 // BEAUTY &amp; MARCA</div>
            </div>

            <!-- FRAME 6 -->
            <div class="parallax-frame square offset-mid" onclick="openLightbox('assets/google_business_kit/07_google_interior_fitness_karla.jpg', 'Karla P. · Atleta Fitness &amp; Nutrición', 'Colinas de San Jerónimo 11 · Nikon Z9')">
              <img src="assets/google_business_kit/07_google_interior_fitness_karla.jpg" alt="Karla Fitness" class="inner-img">
              <div class="parallax-badge">06 // ATLETA NUTRICIÓN</div>
            </div>

          </div>
        </div>
        <div class="vortex-hint-pill" style="margin-top: 25px;">
          <span>Arrastra horizontalmente o desliza para experimentar el desplazamiento óptico parallax</span> ✦
        </div>
      </div>

      <!-- ====================================================================
           MODO 3: PORTAFOLIO AUTORIZADO · 13 ÁLBUMES OFICIALES (CAPTOORA.STUDIO)
           ==================================================================== -->
      <div class="grid-view-container" id="grid-view-box">
        
        <!-- FILTROS POR CATEGORÍA PRINCIPAL (13 ÁLBUMES) -->
        <div class="collection-filter">
          <button class="cat-pill active" onclick="filterCategory('all', this)">Todos los Álbumes (13)</button>
          <button class="cat-pill" onclick="filterCategory('estudio', this)">Estudio &amp; Ciclorama</button>
          <button class="cat-pill" onclick="filterCategory('editorial', this)">Editorial &amp; Viajes</button>
          <button class="cat-pill" onclick="filterCategory('familia', this)">Familia &amp; Niños</button>
          <button class="cat-pill" onclick="filterCategory('exteriores', this)">Exteriores &amp; Bosque</button>
          <button class="cat-pill" onclick="filterCategory('eventos', this)">Eventos &amp; Celebraciones</button>
        </div>

        <div class="portfolio-grid" id="main-portfolio-grid">
          <!-- ÁLBUM 01: SESIÓN 2025 PERSONAL BRANDING -->
          <div class="photo-card" data-cat="editorial" onclick="openLightbox('assets/media_jpg/pf-poncho25-01.jpg', 'Álbum 01 · Sesión 2025 Personal Branding', 'Monterrey, N.L. · Nikon Z · 50mm f/1.2 · Luz Dorada')">
            <div class="photo-img-box">
              <img src="assets/media_jpg/pf-poncho25-01.jpg" alt="Álbum 01 Sesión 2025" loading="lazy">
            </div>
            <div class="photo-meta">
              <span class="photo-tag">ÁLBUM 01 // EDITORIAL &amp; BRANDING</span>
              <span class="photo-telemetry">4 OBRAS</span>
            </div>
            <div class="photo-name">Sesión 2025 · Personal Branding</div>
          </div>

          <!-- ÁLBUM 02: PELONI 9 AÑOS GALA -->
          <div class="photo-card" data-cat="familia" onclick="openLightbox('assets/media_jpg/pf-peloni-01.jpg', 'Álbum 02 · Peloni 9 Años Gala', 'Monterrey, N.L. · Óptica Fija · Retrato Cándido')">
            <div class="photo-img-box">
              <img src="assets/media_jpg/pf-peloni-01.jpg" alt="Álbum 02 Peloni 9 Años" loading="lazy">
            </div>
            <div class="photo-meta">
              <span class="photo-tag">ÁLBUM 02 // FAMILIA &amp; NIÑOS</span>
              <span class="photo-telemetry">3 OBRAS</span>
            </div>
            <div class="photo-name">Peloni · 9 Años Gala</div>
          </div>

          <!-- ÁLBUM 03: PARQUE RUFINO TAMAYO -->
          <div class="photo-card" data-cat="exteriores" onclick="openLightbox('assets/media_jpg/pf-tamayo-01.jpg', 'Álbum 03 · Parque Rufino Tamayo Exterior', 'San Pedro Garza García, N.L. · Luz Natural de Tarde · 24MP')">
            <div class="photo-img-box">
              <img src="assets/media_jpg/pf-tamayo-01.jpg" alt="Álbum 03 Parque Rufino Tamayo" loading="lazy">
