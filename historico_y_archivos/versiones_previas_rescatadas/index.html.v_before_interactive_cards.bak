  <!-- LOAD CAPTOORA 3D ENGINE -->
  <script src="js/captoora_3d_engine.js"></script>

  <!-- INSIDE THE CAMERA 3D VORTEX & INTERACTION LOGIC -->
  <script>
    /* ==========================================================================
       VORTEX 3D SWIRL (REELFOLIO INSPIRATION)
       ========================================================================== */
    const vortexData = [
      {
        src: 'assets/media_jpg/FARMASI_CPT_0728_LULU_ESTUDIO_PRO.jpg',
        title: 'Lulú H. · Retrato Editorial',
        badge: 'EDITORIAL // SET 01',
        cat: 'editorial'
      },
      {
        src: 'assets/media_jpg/FARMASI_CPT_0554_BRENDA_ESTUDIO_PRO.jpg',
        title: 'Brenda M. · Beauty & Marca',
        badge: 'BEAUTY // SET 02',
        cat: 'editorial'
      },
      {
        src: 'assets/media_jpg/pf-glow-cpt_0853.jpg',
        title: 'GlowTours Oficial · Amapola',
        badge: 'EVENTOS // SET 03',
        cat: 'editorial'
      },
      {
        src: 'assets/media_jpg/pf-chipinque-01.jpg',
        title: 'Sierra de Chipinque',
        badge: 'NATURALEZA // EXTERIOR',
        cat: 'familia'
      },
      {
        src: 'assets/media_jpg/pf-chipinque-fam.jpg',
        title: 'Familia bajo los Pinos',
        badge: 'FAMILIA // RECUERDOS',
        cat: 'familia'
      },
      {
        src: 'assets/media_jpg/IG_CPT_0550_4x5.jpg',
        title: 'Biometría con Alma',
        badge: 'BIOMETRÍA // RECOMPOSICIÓN',
        cat: 'biometrics'
      },
      {
        src: 'assets/referencias_generadas/ref_park_autumn_3x4.jpg',
        title: 'Golden Hour en Parque',
        badge: 'OTOÑO // LUZ DORADA',
        cat: 'otono'
      },
      {
        src: 'assets/pexels/story1_kid_pumpkin_5435308.jpg',
        title: 'Pumpkin Patch Infantil',
        badge: 'PUMPKIN // TEMPORADA',
        cat: 'otono'
      },
      {
        src: 'assets/media_jpg/FARMASI_CPT_0735_LULU_ESTUDIO_PRO.jpg',
        title: 'Lulú H. · Perfil Direccional',
        badge: 'EDITORIAL // SET 04',
        cat: 'editorial'
      },
      {
        src: 'assets/media_jpg/pf-glow-cpt_0878.jpg',
        title: 'GlowTours · Escenario Estelar',
        badge: 'EVENTOS // SET 05',
        cat: 'editorial'
      },
      {
        src: 'assets/media_jpg/IG_CPT_0700_4x5.jpg',
        title: 'Clon 3D Volumétrico',
        badge: 'BIOMETRÍA // 3D',
        cat: 'biometrics'
      },
      {
        src: 'assets/media_jpg/pf-chipinque-02.jpg',
        title: 'Retrato en la Niebla',
        badge: 'EXTERIOR // CHIPINQUE',
        cat: 'familia'
      }
    ];

    let currentRotationY = 0;
    let targetRotationY = 0;
    let isDraggingVortex = false;
    let startPointerX = 0;
    let vortexStageEl = document.getElementById('vortex-spiral-stage');
    let vortexViewportEl = document.getElementById('vortex-viewport');

    function build3DVortex() {
      if (!vortexStageEl) return;
      vortexStageEl.innerHTML = '';

      const total = vortexData.length;
      const radius = 480; // Horizontal radius of the swirl
      const verticalSpread = 22; // Height spread per card along spiral

      vortexData.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'vortex-card';

        // Helical spiral math: angle around cylinder + vertical elevation + depth
        const angle = (index / total) * Math.PI * 3.5; // 3.5 turns
        const x = Math.sin(angle) * radius;
        const z = Math.cos(angle) * radius;
        const y = (index - total / 2) * verticalSpread;
        const rotateYDeg = (angle * 180 / Math.PI) + 180;

        card.style.transform = `translate3d(${x}px, ${y}px, ${z}px) rotateY(${rotateYDeg}deg)`;

        card.innerHTML = `
          <img src="${item.src}" alt="${item.title}" class="vortex-card-img" loading="lazy">
          <div class="vortex-card-overlay">
            <span class="vortex-badge">${item.badge}</span>
            <div class="vortex-card-title">${item.title}</div>
          </div>
        `;

        card.addEventListener('click', (e) => {
          e.stopPropagation();
          openLightbox(item.src, item.title, 'Nikon Z9 · Nikkor Z 50mm f/1.2 S · 1/250s · f/1.4 · ISO 100');
        });

        vortexStageEl.appendChild(card);
      });
    }

    // Vortex drag & scroll physics
    if (vortexViewportEl) {
      vortexViewportEl.addEventListener('pointerdown', (e) => {
        isDraggingVortex = true;
        startPointerX = e.clientX;
      });

      window.addEventListener('pointermove', (e) => {
        if (!isDraggingVortex) return;
        const deltaX = e.clientX - startPointerX;
        startPointerX = e.clientX;
        targetRotationY += deltaX * 0.35;
      });

      window.addEventListener('pointerup', () => {
        isDraggingVortex = false;
      });

      // Mouse wheel rotation over vortex
      vortexViewportEl.addEventListener('wheel', (e) => {
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
          targetRotationY += e.deltaX * 0.3;
        } else {
          targetRotationY += e.deltaY * 0.25;
        }
      }, { passive: true });
    }

    // Smooth inertia render loop for vortex
    function updateVortex() {
      currentRotationY += (targetRotationY - currentRotationY) * 0.08;
      if (vortexStageEl) {
        vortexStageEl.style.transform = `rotateY(${currentRotationY}deg)`;
      }
      requestAnimationFrame(updateVortex);
    }

    // VIEW MODE SWITCHER (REELS vs VORTEX vs PARALLAX vs GRID)
    function setGalleryViewMode(mode) {
      const btnReels = document.getElementById('btn-reels-mode');
      const btnVortex = document.getElementById('btn-vortex-mode');
      const btnParallax = document.getElementById('btn-parallax-mode');
      const btnGrid = document.getElementById('btn-grid-mode');

      const reelsBox = document.getElementById('reels-viewport');
      const vortexBox = document.getElementById('vortex-viewport');
      const parallaxBox = document.getElementById('parallax-viewport');
      const gridBox = document.getElementById('grid-view-box');

      // Reset all buttons
      [btnReels, btnVortex, btnParallax, btnGrid].forEach(b => { if (b) b.classList.remove('active'); });

      // Reset all views
      if (reelsBox) reelsBox.style.display = 'none';
      if (vortexBox) vortexBox.style.display = 'none';
      if (parallaxBox) parallaxBox.style.display = 'none';
      if (gridBox) gridBox.classList.remove('active');

      if (mode === 'reels') {
        if (btnReels) btnReels.classList.add('active');
        if (reelsBox) reelsBox.style.display = 'flex';
        if (window.updateIndexCoverflow) window.updateIndexCoverflow();
      } else if (mode === 'vortex') {
        if (btnVortex) btnVortex.classList.add('active');
        if (vortexBox) vortexBox.style.display = 'block';
      } else if (mode === 'parallax') {
        if (btnParallax) btnParallax.classList.add('active');
        if (parallaxBox) parallaxBox.style.display = 'block';
        if (window.updateIndexParallaxShift) window.updateIndexParallaxShift();
      } else if (mode === 'grid') {
        if (btnGrid) btnGrid.classList.add('active');
        if (gridBox) gridBox.classList.add('active');
      }
    }

    /* ==========================================================================
       SCROLLTIDE 3D COVERFLOW REEL SLIDER (INDEX)
       ========================================================================== */
    function initIndexReelSlider() {
      const track = document.getElementById('index-reel-track');
      const cards = Array.from(document.querySelectorAll('#index-reel-track .reel-card'));
      const dotsContainer = document.getElementById('idx-reel-dots');
      const btnPrev = document.getElementById('btn-idx-reel-prev');
      const btnNext = document.getElementById('btn-idx-reel-next');

      if (!track || !cards.length) return;

      let currentIndex = 0;
      const total = cards.length;

      // Create pagination dots
      if (dotsContainer) {
        dotsContainer.innerHTML = '';
        cards.forEach((_, i) => {
          const dot = document.createElement('button');
          dot.className = `reel-dot ${i === 0 ? 'active' : ''}`;
          dot.setAttribute('aria-label', `Reel ${i + 1}`);
          dot.addEventListener('click', () => goToIndex(i));
          dotsContainer.appendChild(dot);
        });
      }

      function updateCoverflow() {
        const dots = dotsContainer ? Array.from(dotsContainer.querySelectorAll('.reel-dot')) : [];
        cards.forEach((card, i) => {
          const diff = i - currentIndex;
          const absDiff = Math.abs(diff);

          if (diff === 0) {
            // Center active card
            card.style.transform = `translateX(0) translateZ(0) rotateY(0deg) scale(1)`;
            card.style.opacity = '1';
            card.style.zIndex = '10';
            card.style.filter = 'drop-shadow(0 20px 40px rgba(0,0,0,0.85)) drop-shadow(0 0 25px rgba(204,255,0,0.25))';
            card.style.pointerEvents = 'auto';
            card.classList.add('active');
          } else {
            // Surrounding cards with perspective depth
            const xOffset = diff * 260;
            const zOffset = -120 * absDiff;
            const rotY = diff < 0 ? 28 : -28;
            const scale = Math.max(0.72, 1 - absDiff * 0.14);
            const opacity = Math.max(0, 0.85 - absDiff * 0.28);

            card.style.transform = `translateX(${xOffset}px) translateZ(${zOffset}px) rotateY(${rotY}deg) scale(${scale})`;
            card.style.opacity = `${opacity}`;
            card.style.zIndex = `${10 - absDiff}`;
            card.style.filter = 'brightness(0.65) drop-shadow(0 15px 30px rgba(0,0,0,0.8))';
            card.style.pointerEvents = absDiff > 2 ? 'none' : 'auto';
            card.classList.remove('active');
          }
        });

        dots.forEach((dot, idx) => {
          dot.classList.toggle('active', idx === currentIndex);
        });
      }

      window.updateIndexCoverflow = updateCoverflow;

      function goToIndex(idx) {
        currentIndex = Math.max(0, Math.min(total - 1, idx));
        updateCoverflow();
      }

      if (btnPrev) btnPrev.addEventListener('click', () => goToIndex(currentIndex - 1));
      if (btnNext) btnNext.addEventListener('click', () => goToIndex(currentIndex + 1));

      // Click card to navigate if not center
      cards.forEach((card, idx) => {
        card.addEventListener('click', (e) => {
          if (idx !== currentIndex) {
            e.stopPropagation();
            goToIndex(idx);
          }
        });
      });

      // Swipe / Drag Physics
      let startX = 0;
      let diffX = 0;
      let isDragging = false;

      track.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.clientX;
        diffX = 0;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        diffX = e.clientX - startX;
      });

      window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        if (diffX < -50) goToIndex(currentIndex + 1);
        else if (diffX > 50) goToIndex(currentIndex - 1);
      });

      track.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0) startX = e.touches[0].clientX;
        diffX = 0;
      }, { passive: true });

      track.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) diffX = e.touches[0].clientX - startX;
      }, { passive: true });

      track.addEventListener('touchend', () => {
        if (diffX < -40) goToIndex(currentIndex + 1);
        else if (diffX > 40) goToIndex(currentIndex - 1);
      });

      updateCoverflow();
    }

    /* ==========================================================================
       SCROLLTIDE PARALLAX ROW DRIFT (INDEX)
       ========================================================================== */
    function initIndexParallaxRow() {
      const container = document.getElementById('index-parallax-container');
      const innerImgs = Array.from(document.querySelectorAll('#index-parallax-row .inner-img'));
      if (!container || !innerImgs.length) return;

      let isDown = false;
      let startX, scrollLeft;

      container.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - container.offsetLeft;
        scrollLeft = container.scrollLeft;
      });
      container.addEventListener('mouseleave', () => { isDown = false; });
      container.addEventListener('mouseup', () => { isDown = false; });
      container.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - container.offsetLeft;
        const walk = (x - startX) * 1.5;
        container.scrollLeft = scrollLeft - walk;
        updateIndexParallaxShift();
      });

      function updateIndexParallaxShift() {
        const center = container.scrollLeft + container.offsetWidth / 2;
        innerImgs.forEach(img => {
          const frame = img.parentElement;
          const frameCenter = frame.offsetLeft + frame.offsetWidth / 2;
          const delta = (frameCenter - center) * 0.12;
          img.style.transform = `translateX(${delta}px)`;
        });
      }

      window.updateIndexParallaxShift = updateIndexParallaxShift;
      container.addEventListener('scroll', updateIndexParallaxShift, { passive: true });
      updateIndexParallaxShift();
    }

    // CATEGORY FILTER
    function filterCategory(category, buttonEl) {
      document.querySelectorAll('.cat-pill').forEach(btn => btn.classList.remove('active'));
      if (buttonEl) buttonEl.classList.add('active');

      const cards = document.querySelectorAll('.portfolio-grid .photo-card');
      cards.forEach(card => {
        const cardCat = card.getAttribute('data-cat');
        if (category === 'all' || cardCat === category) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // LIGHTBOX CONTROLS
    function openLightbox(src, title, exif) {
      const modal = document.getElementById('lightbox-modal');
      const img = document.getElementById('lightbox-img-el');
      const caption = document.getElementById('lightbox-caption-el');
      if (modal && img) {
        img.src = src;
        caption.innerHTML = `<strong>${title}</strong><br><span style="color: #94a3b8; font-size: 11px;">${exif}</span>`;
        modal.classList.add('active');
      }
    }

    function closeLightbox(e) {
      if (e.target.id === 'lightbox-modal' || e.target.classList.contains('lightbox-close-btn')) {
        document.getElementById('lightbox-modal').classList.remove('active');
      }
    }

    // Initialize 3D Vortex, Coverflow, and Parallax on load
    document.addEventListener('DOMContentLoaded', () => {
      build3DVortex();
      updateVortex();
      initIndexReelSlider();
      initIndexParallaxRow();
    });
  </script>

</body>
</html>
