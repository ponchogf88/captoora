# ==============================================================================
# CAPTOORA STUDIO · PLANTILLA DE VARIABLES DE ENTORNO (.env)
# ==============================================================================
# INSTRUCCIONES:
# Copia este archivo a `.env` (gitignored) y pega aquí tus llaves reales.
# NUNCA compartas `.env` ni lo subas a GitHub.
# Los campos marcados [OPCIONAL] no bloquean el arranque de los 7 Agentes.
# ==============================================================================

# 1. CORREO CORPORATIVO ZOHO MAIL (REQUERIDO PARA ENVIAR DESDE chuy@captoora.studio)
# Genera la App Password en: https://accounts.zoho.com/home#security/app_password
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=chuy@captoora.studio
SMTP_PASS=
SMTP_FROM_NAME=Jesús Gutiérrez · Captoora Studio

# 2. CONTROL DE CALENDLY (EL ENLACE BASE ES SUFICIENTE PARA CREAR LINKS POR CLIENTE)
# Ejemplo: https://calendly.com/captoora
CALENDLY_BASE_URL=
# [OPCIONAL] Personal Access Token de Calendly para leer citas agendadas vía API:
CALENDLY_API_TOKEN=
# [OPCIONAL] Webhook Signing Key si conectas Webhook entrante de Calendly:
CALENDLY_WEBHOOK_SIGNING_KEY=

# 3. META WHATSAPP CLOUD API (SOLO SI QUIERES ENVÍO AUTOMÁTICO SIN ABRIR wa.me)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=captoora_webhook_2026
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PUBLIC_BASE_URL=https://captoora.studio

# 4. BUSCADOR APIFY MULTI-ZONA
# [OPCIONAL] Si queda vacío, se usa el token ya configurado en scripts/run_apify_production.py
APIFY_TOKEN=

# 5. CRM / GOHIGHLEVEL (WEBHOOKS & API)
# Webhook 1 (Saliente): Pega aquí tu Inbound Webhook URL de GoHighLevel (Workflows)
GHL_WEBHOOK_URL=
# [OPCIONAL] Private Integration Key / Location ID de GoHighLevel:
GHL_API_KEY=
GHL_LOCATION_ID=

# 6. MAILERFIND (ENRIQUECIMIENTO DE CORREOS)
# [OPCIONAL] Si no se llena, el sistema busca correos públicos directo en los 91 sitios web
MAILERFIND_API_KEY=
MAILERFIND_MCP_URL=

# 7. GOOGLE AI PRO / GMAIL / GOOGLE DRIVE (CONECTORES GOOGLE)
GEMINI_API_KEY=
# [OPCIONAL] Gmail backup SMTP si alguna campaña sale desde Gmail:
GMAIL_USER=
GMAIL_APP_PASSWORD=
# [OPCIONAL] Google Drive / OAuth MCP (para respaldos automáticos de dossiers y reportes):
GDRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 8. SEGURIDAD DE WEBHOOK #2 (ENTRANTES A TU SERVIDOR :8765 DESDE TÚNEL PÚBLICO)
CAPTOORA_WEBHOOK_SECRET=
